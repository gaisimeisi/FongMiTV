<?xml version="1.0" encoding="utf-8"?>
<!--
    启动闪屏基础图形，与 launcher 图标保持一致：
    深蓝渐变底 + 青绿播放三角 + 底部一条细线。
    注意：ic_splash_logo_animated.xml 通过 target name="logo_motion" 挂动画，组名必须保留。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="splash_logo"
    android:width="432dp"
    android:height="432dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="logo_motion"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 圆角底色 -->
        <path
            android:pathData="M18,6 L90,6 A12,12 0 0,1 102,18 L102,90 A12,12 0 0,1 90,102 L18,102 A12,12 0 0,1 6,90 L6,18 A12,12 0 0,1 18,6 Z"
            android:fillColor="#12202F" />

        <!-- 播放三角 -->
        <path
            android:pathData="M42,33 L75,54 L42,75 Z"
            android:fillColor="#4CF5CB" />

        <!-- 底部细线 -->
        <path
            android:pathData="M32,83 L76,83"
            android:strokeWidth="3"
            android:strokeColor="#7FDCFF"
            android:strokeAlpha="0.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
