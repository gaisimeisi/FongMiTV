<resources>

    <dimen name="playback_dialog_inset">24dp</dimen>
    <dimen name="playback_dialog_spacing">8dp</dimen>
    <dimen name="playback_dialog_switch_width">47dp</dimen>
    <dimen name="playback_dialog_tab_content_spacing">16dp</dimen>

    <integer name="mpv_script_action_spacing">16</integer>
    <integer name="mpv_script_item_spacing">16</integer>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:windowFullscreen">true</item>
        <!--
            状态栏 / 导航栏设置为透明，让窗口背景（深色）延伸到顶部区域。
            之前用的是 windowTranslucentStatus，它会让系统背景透出来，车机上顶部会是一片空白；
            影视仓用的是 statusBarColor=transparent + 背景延伸，所以顶部是正常的深色。
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 异形屏 / 车机挖孔区域也铺满内容，避免顶部留白 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 窗口背景固定深色：任何未被子 View 覆盖的区域（包括车机顶部预留区）都是深色，不是白块 -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Control.Script" parent="Control">
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="PlaybackDialogHeader">
        <item name="android:paddingStart">@dimen/playback_dialog_inset</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">@dimen/playback_dialog_inset</item>
        <item name="android:paddingBottom">@dimen/playback_dialog_spacing</item>
    </style>

    <style name="PlaybackDialogTitle">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="PlaybackDialogAction" parent="Widget.Material3.Button.TonalButton">
        <item name="strokeColor">@color/selector_playback_dialog_action</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="PlaybackDialogTabs">
        <item name="android:layout_marginStart">@dimen/playback_dialog_inset</item>
        <item name="android:layout_marginEnd">@dimen/playback_dialog_inset</item>
        <item name="android:layout_marginBottom">@dimen/playback_dialog_spacing</item>
        <item name="selectionRequired">true</item>
        <item name="singleSelection">true</item>
    </style>

    <style name="PlaybackDialogTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/selector_playback_dialog_tab</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="PlaybackDialogSwitch">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:scaleX">0.75</item>
        <item name="android:scaleY">0.75</item>
    </style>

    <style name="PlaybackDialogSwitchContainer">
        <item name="android:layout_width">@dimen/playback_dialog_switch_width</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:addStatesFromChildren">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:foreground">@drawable/selector_playback_dialog_switch</item>
    </style>

    <style name="PlaybackDialogFirstRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/playback_dialog_inset</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">@dimen/playback_dialog_inset</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="PlaybackDialogTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <style name="PlaybackDialogBody">
        <item name="android:paddingBottom">@dimen/playback_dialog_inset</item>
    </style>

    <style name="PlaybackContentAction" parent="PlaybackDialogAction" />

    <style name="PlaybackContentCurrentAction" parent="PlaybackContentAction">
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textColor">@color/selector_content_current</item>
    </style>

    <style name="PlaybackContentTab" parent="PlaybackDialogTab" />

    <style name="PlaybackContentItem">
        <item name="android:background">@drawable/selector_chip_round</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="PlaybackContentText">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="MpvScriptItem">
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

</resources>
